{
    "name": "example/pca-laravel-server",
    "description": "A Laravel API route guarded by Proof-Carrying Authority.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        { "type": "path", "url": "../.." }
    ],
    "require": {
        "php": "^8.2",
        "atlas-auth/atlas-pca": "*@dev",
        "laravel/framework": "^12.0",
        "nyholm/psr7": "^1.8",
        "psr/http-server-middleware": "^1.0",
        "symfony/psr-http-message-bridge": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": { "php-http/discovery": true }
    }
}
