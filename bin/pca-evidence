#!/usr/bin/env php
<?php
declare(strict_types=1);

// The standalone dispute-evidence replay verifier: `pca-evidence verify <bundle.json> [--trust trust.json] [--json] [--allow-unpinned]`
// or `pca-evidence digest <bundle.json>` (see Atlas\Pca\EvidenceCli for the exit codes).
foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}
exit(Atlas\Pca\EvidenceCli::main(array_slice($argv, 1)));
