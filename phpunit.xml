<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Atlas PCA PHP SDK">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- a mutant that loops while growing an array must die at the limit instead of taking the CI runner down (shard 7 was
             killed by a runner shutdown twice); the unmutated suite peaks at about 600 MB -->
        <ini name="memory_limit" value="1536M"/>
    </php>
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
</phpunit>
